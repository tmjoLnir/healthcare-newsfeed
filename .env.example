# Telegram bot credentials.
# Create the bot with @BotFather, then open the chat that should receive the
# digest and send the bot /start — a bot cannot write to a chat that has not
# written to it first. TELEGRAM_CHAT_ID is that chat's numeric id, not a
# @username; read it back with:
#
#   curl -s "https://api.telegram.org/bot$TELEGRAM_BOT_TOKEN/getUpdates" \
#     | jq '.result[-1].message.chat.id'
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_CHAT_ID=123456789

# Where the SQLite store lives.
NEWSFEED_DB=data/newsfeed.db

# Only needed behind a TLS-terminating proxy.
# REQUESTS_CA_BUNDLE=/path/to/ca-bundle.crt
