# Telegram bot credentials.
# Create the bot with @BotFather, add it to your channel as an administrator
# with "Post messages" permission, then copy the values here.
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_CHAT_ID=@your_channel_name

# Where the SQLite store lives.
NEWSFEED_DB=data/newsfeed.db

# Only needed behind a TLS-terminating proxy.
# REQUESTS_CA_BUNDLE=/path/to/ca-bundle.crt
